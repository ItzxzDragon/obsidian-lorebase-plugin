{
    "name": "lorevault",
    "version": "0.1.0",
    "description": "A personal media library for Obsidian with customizable libraries, views, filters, sorting, grouping, and rich cards.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "library",
        "media",
        "custom-library",
        "views",
        "filters"
    ],
    "author": "ItzxzDragon",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "esbuild": "^0.28.0",
        "obsidian": "1.11.4",
        "tslib": "^2.8.1",
        "typescript": "^5.3.2",
        "vitest": "^4.0.18"
    }
}
